{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/pages/**/*.astro", "src/layouts/**/*.astro", "src/components/**/*.astro", "src/data/**/*.ts", "src/lib/**/*.ts", "tests/unit/**/*.ts", "tests/e2e/site.spec.ts", "playwright.config.ts"],
  "exclude": ["node_modules", ".open-next", "dist", "src/app", "src/collections", "src/migrations", "src/payload.config.ts", "src/payload-types.ts", "tests/helpers", "tests/int"]
}

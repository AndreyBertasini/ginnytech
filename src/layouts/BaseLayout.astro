---
export interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Un corso gratuito in italiano per collegare dati, analisi e decisioni. Esplora il programma GinnyTech e scegli il tuo percorso.' } = Astro.props;
const pageTitle = title ? `${title} — GinnyTech` : 'GinnyTech — Corso gratuito di Analytics e Data Engineering';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ginnytech.it').toString();
const socialImage = new URL('/social-card.png', Astro.site || 'https://ginnytech.it').toString();
const navigation = [
  { href: '/programma/', label: 'Programma' },
  { href: '/informazioni/', label: 'Come funziona' },
  { href: '/chi-sono/', label: 'Chi sono' },
  { href: '/articoli/', label: 'Articoli' },
  { href: '/glossario/', label: 'Glossario' },
  { href: '/cerca/', label: 'Cerca' },
];
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="GinnyTech: corso gratuito in italiano su analytics, marketing e data engineering." />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="GinnyTech" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content="GinnyTech: corso gratuito in italiano su analytics, marketing e data engineering." />
  <link rel="stylesheet" href="/styles/global.css" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a href="#contenuto" class="skip-link">Vai al contenuto</a>
  <header class="site-header">
    <div class="inner">
      <a href="/" class="site-logo" aria-label="GinnyTech — pagina iniziale">
        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" width="28" height="28" aria-hidden="true"><path d="M10 2L3 7v6l7 5 7-5V7l-7-5zm0 2.5L15.5 8v4L10 15.5 4.5 12V8L10 4.5z" fill="currentColor"/></svg>
        GinnyTech
      </a>
      <button class="hamburger" id="menu-toggle" aria-label="Apri menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button>
      <nav class="site-nav" id="site-nav" aria-label="Navigazione principale">
        {navigation.map(item => <a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, '') === item.href.replace(/\/$/, '') ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <div class="header-cta"><a href="https://ginnytech.it/course" class="btn btn-primary">Corso gratuito</a></div>
    </div>
  </header>

  <main id="contenuto" tabindex="-1"><slot /></main>

  <footer class="site-footer">
    <div class="inner">
      <div class="footer-brand">
        <a href="/" class="site-logo">GinnyTech</a>
        <p>Un percorso gratuito in italiano per collegare dati, analisi e decisioni.</p>
        <div class="footer-social"><a href="https://github.com/AndreyBertasini/ginnytech" target="_blank" rel="noopener noreferrer" aria-label="GitHub (si apre in una nuova scheda)">GitHub</a><a href="https://www.linkedin.com/in/andrii-dyshkantiuk/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (si apre in una nuova scheda)">LinkedIn</a></div>
      </div>
      <div class="footer-col"><h2>Formazione</h2><ul><li><a href="/programma/">Programma e percorsi</a></li><li><a href="https://ginnytech.it/course">Corso gratuito</a></li><li><a href="/glossario/">Glossario</a></li></ul></div>
      <div class="footer-col"><h2>Risorse</h2><ul><li><a href="/informazioni/">Come funziona</a></li><li><a href="/articoli/">Articoli</a></li><li><a href="/cerca/">Cerca un modulo</a></li></ul></div>
      <div class="footer-col"><h2>Contatti</h2><ul><li><a href="/chi-sono/">Chi sono</a></li><li><a href="/prenota-call/">Parliamone</a></li><li><a href="/privacy/">Privacy</a></li></ul></div>
    </div>
    <div class="footer-bottom"><p>&copy; {new Date().getFullYear()} GinnyTech · Creato da Andrii Dyshkantiuk</p></div>
  </footer>
</body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (toggle && nav) {
    const close = () => {
      nav.classList.remove('nav-open');
      toggle.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Apri menu');
    };
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('nav-open');
      toggle.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
    });
    nav.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        close();
        toggle.focus();
      }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !nav.contains(event.target) && !toggle.contains(event.target)) close();
    });
  }
</script>

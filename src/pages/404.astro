---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste o è stata spostata. Riparti dal programma del corso gratuito GinnyTech." noindex>
  <section class="page-hero">
    <p class="eyebrow">Errore 404</p>
    <h1>Questa pagina non esiste</h1>
    <p class="hero-sub">Forse il link è vecchio o c’è un errore di battitura. Da qui puoi ripartire.</p>
    <div class="hero-cta">
      <a href="/programma/" class="btn btn-primary">Vai al programma</a>
      <a href="/cerca/" class="btn btn-ghost">Cerca un modulo</a>
    </div>
  </section>
</BaseLayout>

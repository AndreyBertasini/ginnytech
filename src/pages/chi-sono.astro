---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stages, modules, learningPaths } from '../data/course';
import { glossaryTerms } from '../data/glossary';

const site = 'https://ginnytech.it';
const pageUrl = `${site}/chi-sono/`;
const linkedin = 'https://www.linkedin.com/in/andrii-dyshkantiuk/';
const github = 'https://github.com/AndreyBertasini';

// Numeri reali, calcolati dai dati del corso: niente cifre inventate.
const moduleCount = modules.length;
const stageCount = stages.length;
const topicCount = modules.reduce((sum, m) => sum + m.topics.length, 0);
const outcomeCount = modules.reduce((sum, m) => sum + m.outcomes.length, 0);
const glossaryCount = glossaryTerms.length;

// Mappa del corso: moduli × aree di competenza. L'intensità conta quante volte
// l'area compare nei testi reali del modulo (titolo, sintesi, argomenti, risultati, esercitazione).
const areas = [
  { label: 'SQL', re: /\bsql\b|query|join|window/g },
  { label: 'Modelli dati', re: /modellazion|warehouse|grain|dbt|trasformazion|semantic|storicizz|contract/g },
  { label: 'Metriche', re: /metric|kpi|indicator|baseline/g },
  { label: 'Marketing', re: /marketing|campagn|funnel|retention|coort|\bcac\b|\bltv\b|conversion|attivazion/g },
  { label: 'Statistica', re: /statistic|probabilit|a\/b|inferenz|distribuz|significativ|causal|esperiment/g },
  { label: 'Previsioni', re: /previs|forecast|prediction|regression|scenari|modelli predittiv/g },
  { label: 'Pipeline', re: /pipeline|kafka|stream|ingestion|lake|storage|tempo reale|real.?time|clickhouse|deploy|monitor/g },
  { label: 'Dashboard', re: /dashboard|visualizz|report|alert/g },
  { label: 'Decisioni', re: /decision|decid|raccomand|evidenz|ragionament/g },
];
const columns = stages.flatMap((stage, stageIndex) =>
  stage.moduleIds.map((id, i) => {
    const m = modules.find(mod => mod.id === id)!;
    const text = [m.title, m.summary, ...m.keywords, ...m.topics, ...m.outcomes, m.practice.brief, m.practice.deliverable, ...m.practice.criteria].join(' ').toLowerCase();
    const scores = areas.map(a => (text.match(a.re) ?? []).length);
    return { m, stageIndex, stageTitle: stage.title, firstOfStage: i === 0, scores };
  }),
);
const maxScore = Math.max(...columns.flatMap(c => c.scores));
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil((n / maxScore) * 4)));
let peak = { col: columns[0], area: 0, score: -1 };
for (const c of columns) c.scores.forEach((sc, ai) => { if (sc > peak.score) peak = { col: c, area: ai, score: sc }; });
const activeCells = columns.reduce((s, c) => s + c.scores.filter(Boolean).length, 0);

const stack = [
  { name: 'SQL', role: 'La base di tutto', text: 'Ogni analisi seria parte da una query che un collega può rileggere, rieseguire e contestare.' },
  { name: 'ClickHouse', role: 'Analisi su grandi volumi', text: 'Database colonnare per aggregare milioni di eventi in secondi, senza aspettare il report del giorno dopo.' },
  { name: 'dbt', role: 'Trasformazioni versionate', text: 'Modelli SQL con test, documentazione e dipendenze esplicite. Se una metrica cambia, si vede dove e perché.' },
  { name: 'Python', role: 'Quando SQL non basta', text: 'Modelli, analisi esplorative e script che trasformano un controllo manuale in un passaggio ripetibile.' },
  { name: 'n8n', role: 'Automazioni', text: 'Flussi che collegano API, report e notifiche. Il lavoro ripetitivo lo fa il sistema, non una persona il lunedì mattina.' },
  { name: 'CatBoost', role: 'Modelli previsionali', text: 'Gradient boosting su dati tabellari pieni di variabili categoriche: churn, propensione, valore del cliente.' },
];

const principles = [
  { title: 'Prima il problema, poi lo strumento', text: 'Una dashboard senza una decisione da prendere è arredamento. Parto sempre dalla domanda: chi deciderà cosa, con quale numero.' },
  { title: 'Cerca il collo di bottiglia', text: 'In ogni sistema di dati c’è un punto che rallenta tutto il resto. Ottimizzare altrove produce lavoro, non risultati.' },
  { title: 'Ogni numero ha un’ipotesi dietro', text: 'Definizioni, filtri, finestre temporali: li scrivo accanto al risultato. Così chi legge sa quanto fidarsi.' },
  { title: 'Se non si può rifare, non è un’analisi', text: 'Codice versionato, dati tracciabili, passaggi documentati. Un risultato che nessuno sa ricostruire è un’opinione.' },
];

const services = [
  { tag: 'Aziende', title: 'Dati affidabili per decidere', text: 'Tracciamento, modello dei dati, metriche condivise e dashboard che reggono alle domande scomode.', href: '/prenota-call/', cta: 'Parliamone' },
  { tag: 'Marketing', title: 'Misurare ciò che conta', text: 'Attribuzione, esperimenti, segmentazione e modelli previsionali collegati a budget e obiettivi reali.', href: '/prenota-call/', cta: 'Prenota una call' },
  { tag: 'Chi studia', title: 'Il corso gratuito', text: `${moduleCount} moduli in italiano, dalla prima query SQL ai flussi di eventi in tempo reale, ognuno con un’esercitazione concreta.`, href: '/programma/', cta: 'Vedi il programma' },
];

const faqs = [
  { q: 'Chi è Andrii Dyshkantiuk?', a: `Sono un professionista dei dati: data engineering, analytics e consulenza. Ho creato GinnyTech, un corso gratuito in italiano con ${moduleCount} moduli che collegano SQL, modellazione, marketing analytics e data engineering alle decisioni di business.` },
  { q: 'Di cosa ti occupi?', a: 'Progetto e costruisco sistemi di dati: raccolta degli eventi, modelli in dbt, database analitici come ClickHouse, automazioni con n8n e modelli previsionali in Python con CatBoost. Il fine è sempre lo stesso: numeri di cui ci si può fidare quando si decide.' },
  { q: 'Il corso GinnyTech è davvero gratuito?', a: `Sì. Il programma completo, ${moduleCount} moduli divisi in ${stageCount} tappe e ${learningPaths.length} percorsi, è gratuito e in italiano. Ogni modulo ha prerequisiti chiari, risultati attesi e un’esercitazione con criteri di verifica.` },
  { q: 'Posso lavorare con te su un progetto?', a: 'Sì. Puoi prenotare una call conoscitiva: partiamo dal problema che vuoi risolvere e capiamo insieme se e come i dati possono aiutarti.' },
];

const chapters = ['Chi sono', 'I numeri', 'Lo stack', 'La mappa', 'Come lavoro', 'Cosa posso fare', 'Domande'];
const total = String(chapters.length).padStart(2, '0');
const ch = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;

const description = `Andrii Dyshkantiuk, data engineering e analytics: SQL, ClickHouse, dbt, Python e modelli previsionali per decisioni migliori. Creatore del corso gratuito GinnyTech.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#page`,
      url: pageUrl,
      name: 'Chi sono — Andrii Dyshkantiuk',
      description,
      inLanguage: 'it-IT',
      mainEntity: { '@id': `${pageUrl}#person` },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'Person',
      '@id': `${pageUrl}#person`,
      name: 'Andrii Dyshkantiuk',
      url: pageUrl,
      jobTitle: 'Data engineer e analytics consultant',
      description: 'Professionista dei dati: data engineering, analytics e consulenza. Creatore di GinnyTech.',
      knowsAbout: ['Data engineering', 'Marketing analytics', 'SQL', 'ClickHouse', 'dbt', 'Python', 'n8n', 'CatBoost', 'Machine learning', 'Analytics engineering'],
      sameAs: [linkedin, github],
      founder: { '@id': `${site}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'GinnyTech',
      url: `${site}/`,
      founder: { '@id': `${pageUrl}#person` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'GinnyTech', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'Chi sono', item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<BaseLayout title="Chi sono — Andrii Dyshkantiuk, data engineering e analytics" {description} ogType="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="lg">
    <!-- 01 · HERO -->
    <section class="lg-hero" id="cap-1" data-chapter={`${ch(0)} · ${chapters[0]}`} aria-labelledby="hero-title">
      <div class="lg-ghost" aria-hidden="true">DATI</div>
      <div class="lg-hero-text rv">
        <p class="mono lg-kicker"><span>Chi sono · GinnyTech</span><span>{ch(0)} · Il profilo</span></p>
        <nav class="mono lg-crumbs" aria-label="Percorso"><a href="/">GinnyTech</a> / <span aria-current="page">Chi sono</span></nav>
        <h1 id="hero-title">Andrii Dyshkantiuk. <span class="grad">Dati che arrivano a una decisione.</span></h1>
        <p class="lg-lead">Lavoro con i dati da ingegnere e da analista: costruisco le pipeline, scrivo le query, alleno i modelli e poi mi chiedo se tutto questo cambia davvero una scelta. Se non la cambia, si torna al punto di partenza.</p>
        <div class="lg-actions">
          <a href="/prenota-call/" class="btn btn-primary btn-lg">Prenota una call</a>
          <a href="/programma/" class="btn btn-ghost btn-lg">Il corso gratuito</a>
        </div>
      </div>

      <div class="lg-kpis" id="cap-2" data-chapter={`${ch(1)} · ${chapters[1]}`} aria-label="GinnyTech in numeri">
        <a href="/programma/" class="kpi kpi-xl kpi-indigo rv">
          <span class="mono kpi-label">Moduli del corso gratuito <span class="tag">Programma</span></span>
          <span class="kpi-num"><span class="mono kpi-unit">N°</span><span data-count={moduleCount}>{moduleCount}</span></span>
        </a>
        <div class="kpi kpi-cyan rv">
          <span class="mono kpi-label">Argomenti trattati</span>
          <span class="kpi-num" data-count={topicCount}>{topicCount}</span>
        </div>
        <div class="kpi kpi-outline rv">
          <span class="mono kpi-label">Tappe del percorso</span>
          <span class="kpi-num" data-count={stageCount}>{stageCount}</span>
        </div>
        <div class="kpi kpi-soft rv">
          <span class="mono kpi-label">Risultati di apprendimento</span>
          <span class="kpi-num" data-count={outcomeCount}>{outcomeCount}</span>
        </div>
        <a href="/glossario/" class="kpi kpi-dark rv">
          <span class="mono kpi-label">Termini nel glossario <span class="tag">Glossario</span></span>
          <span class="kpi-num" data-count={glossaryCount}>{glossaryCount}</span>
        </a>
      </div>
    </section>

    <!-- BIO -->
    <section class="lg-row lg-bio" aria-labelledby="bio-title">
      <header class="lg-side rv">
        <p class="mono">{ch(0)}</p>
        <h2 id="bio-title">Perché faccio questo lavoro</h2>
      </header>
      <div class="lg-body rv">
        <p class="lg-big">Mi occupo di <strong>data engineering</strong>, <strong>marketing analytics</strong> e consulenza. In pratica sto nel punto in cui i dati grezzi diventano un numero che qualcuno userà per decidere.</p>
        <p>Il problema raramente è lo strumento. Di solito è una metrica definita in tre modi diversi, un tracciamento che perde eventi, un modello che nessuno sa più rieseguire. Il mio lavoro è rendere visibili questi punti deboli e sistemarli, partendo da quello che rallenta tutto il resto.</p>
        <p>Ho creato <strong>GinnyTech</strong> perché in italiano mancava un percorso che tenesse insieme le due metà del mestiere: la tecnica, cioè SQL, modellazione e pipeline, e il giudizio, cioè capire quale domanda vale la pena porsi. Il corso è gratuito e segue lo stesso metodo che uso con i clienti.</p>
      </div>
    </section>

    <!-- 03 · STACK -->
    <section class="lg-section" id="cap-3" data-chapter={`${ch(2)} · ${chapters[2]}`} aria-labelledby="stack-title">
      <header class="lg-head rv">
        <p class="mono">{ch(2)} · Lo stack</p>
        <h2 id="stack-title">Gli strumenti che uso ogni giorno</h2>
        <p>Pochi, scelti bene, e ognuno con un compito preciso.</p>
      </header>
      <ul class="stack-grid" role="list">
        {stack.map((s, i) => (
          <li class={`stack-tile rv ${i === 0 ? 'stack-hl' : ''}`} style={`--i:${i}`}>
            <span class="mono stack-idx">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3>
            <p class="mono stack-role">{s.role}</p>
            <p>{s.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- 04 · MAPPA -->
    <section class="lg-section" id="cap-4" data-chapter={`${ch(3)} · ${chapters[3]}`} aria-labelledby="map-title">
      <header class="lg-head rv">
        <p class="mono">{ch(3)} · La mappa</p>
        <h2 id="map-title">Dove il corso alza la voce</h2>
        <p>Ogni colonna è un modulo, nell’ordine del percorso. Ogni riga è un’area di competenza. Più il quadrato è acceso, più quel modulo ci lavora sopra: {activeCells} incroci attivi su {columns.length * areas.length}. Si vede subito dove il corso parte dalle basi e dove arriva alle decisioni.</p>
      </header>

      <figure class="heat rv">
        <p class="mono heat-peak" aria-hidden="true">Picco · M{String(peak.col.m.id).padStart(2, '0')} {peak.col.m.title} · {areas[peak.area].label}</p>
        <div class="heat-scroll">
          <div class="heat-grid" style={`--cols:${columns.length}`} role="img" aria-label={`Mappa del corso: ${moduleCount} moduli incrociati con ${areas.length} aree di competenza. Il picco è il modulo ${peak.col.m.id}, ${peak.col.m.title}, sull'area ${areas[peak.area].label}.`}>
            <span class="heat-corner" aria-hidden="true"></span>
            {columns.map(c => (
              <span class={`mono heat-stage ${c.firstOfStage ? 'is-first' : ''}`} aria-hidden="true">{c.firstOfStage ? String(c.stageIndex + 1).padStart(2, '0') : ''}</span>
            ))}
            {areas.map((area, r) => (
              <>
                <span class="mono heat-row" aria-hidden="true">{area.label}</span>
                {columns.map((c, ci) => {
                  const n = c.scores[r];
                  const isPeak = c === peak.col && r === peak.area;
                  return <span class={`heat-cell q-${level(n)} ${isPeak ? 'is-peak' : ''}`} style={`--d:${ci * 22 + r * 35}ms`} title={`M${c.m.id} · ${area.label}: ${n} riferimenti`}></span>;
                })}
              </>
            ))}
            <span class="heat-corner" aria-hidden="true"></span>
            {columns.map(c => (
              <a class={`mono heat-col ${c === peak.col ? 'is-peak' : ''}`} href={`/programma/${c.m.slug}/`} title={c.m.title} aria-label={`Modulo ${c.m.id}: ${c.m.title}`}>{String(c.m.id).padStart(2, '0')}</a>
            ))}
          </div>
        </div>
        <figcaption class="mono heat-legend">
          <span>Poco</span>
          <span class="legend-scale" aria-hidden="true">{[0, 1, 2, 3, 4].map(q => <i class={`q-${q}`}></i>)}</span>
          <span>Molto</span>
          <span class="legend-sep">1 quadrato = 1 modulo × 1 area · numeri in alto = tappa · clicca un modulo per aprirlo</span>
        </figcaption>
      </figure>

      <ol class="stage-list" role="list">
        {stages.map((s, i) => (
          <li class="rv"><span class="stage-dot"></span><span class="mono">{String(i + 1).padStart(2, '0')}</span><strong>{s.title}</strong><span class="stage-desc">{s.description}</span></li>
        ))}
      </ol>
    </section>

    <!-- 05 · PRINCIPI -->
    <section class="lg-section" id="cap-5" data-chapter={`${ch(4)} · ${chapters[4]}`} aria-labelledby="pr-title">
      <header class="lg-head rv">
        <p class="mono">{ch(4)} · Come lavoro</p>
        <h2 id="pr-title">Quattro regole che non negozio</h2>
      </header>
      <ol class="pr-grid" role="list">
        {principles.map((p, i) => (
          <li class={`pr rv pr-${i}`}>
            <span class="pr-num" aria-hidden="true">{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 06 · SERVIZI -->
    <section class="lg-section" id="cap-6" data-chapter={`${ch(5)} · ${chapters[5]}`} aria-labelledby="sv-title">
      <header class="lg-head rv">
        <p class="mono">{ch(5)} · Cosa posso fare</p>
        <h2 id="sv-title">Con chi lavoro</h2>
      </header>
      <div class="sv-grid">
        {services.map((s, i) => (
          <article class={`sv rv sv-${i}`}>
            <p class="mono sv-tag">{s.tag}</p>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a href={s.href} class="sv-link mono">{s.cta} →</a>
          </article>
        ))}
      </div>
    </section>

    <!-- 07 · FAQ -->
    <section class="lg-row" id="cap-7" data-chapter={`${ch(6)} · ${chapters[6]}`} aria-labelledby="faq-title">
      <header class="lg-side rv">
        <p class="mono">{ch(6)} · Domande</p>
        <h2 id="faq-title">Domande frequenti</h2>
      </header>
      <div class="lg-body faq">
        {faqs.map((f, i) => (
          <details class="rv" open={i === 0}>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="lg-cta rv" aria-labelledby="cta-title">
      <p class="mono">Fine · Parliamone</p>
      <h2 id="cta-title">Hai un problema di dati? Partiamo da lì.</h2>
      <p>Una call conoscitiva serve a capire se il problema è nei dati, nel processo o nella domanda. Spesso è un po’ tutte e tre.</p>
      <div class="lg-actions">
        <a href="/prenota-call/" class="btn btn-primary btn-lg">Prenota una call</a>
        <a href={linkedin} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer me">LinkedIn <span class="sr-only">(si apre in una nuova scheda)</span></a>
      </div>
    </section>
  </div>

  <div class="lg-rail mono" aria-hidden="true">
    <span class="lg-rail-label">{ch(0)} · {chapters[0]}</span>
    <span class="lg-rail-bar"><i></i></span>
  </div>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveal = document.querySelectorAll<HTMLElement>('.lg .rv, .heat');

  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduce || !target) return;
    const start = performance.now();
    const dur = 1100;
    const tick = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(entries => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(animateCount);
        if ((e.target as HTMLElement).dataset.count) animateCount(e.target as HTMLElement);
        io.unobserve(e.target);
      }
    }, { threshold: 0.15 });
    reveal.forEach(el => io.observe(el));

    // Barra dei capitoli in basso, come una storia a capitoli.
    const label = document.querySelector<HTMLElement>('.lg-rail-label');
    const rail = document.querySelector<HTMLElement>('.lg-rail');
    const chapterIo = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting && label) label.textContent = (e.target as HTMLElement).dataset.chapter ?? '';
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll<HTMLElement>('[data-chapter]').forEach(el => chapterIo.observe(el));

    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      rail?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
      rail?.classList.toggle('on', scrollY > 200);
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  } else {
    reveal.forEach(el => el.classList.add('in'));
  }
</script>

<style>
  .lg {
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
    --indigo-deep: #4f46e5;
    --line: var(--color-border);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }
  .mono { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* reveal */
  :global(.js) .rv { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--i, 0) * 70ms); }
  :global(.js) .rv.in { opacity: 1; transform: none; }

  /* HERO */
  .lg-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; padding: 3rem 0 4rem; border-bottom: 1px solid var(--line); overflow: hidden; }
  .lg-ghost { position: absolute; left: 18%; top: 50%; transform: translateY(-50%); font-size: clamp(8rem, 26vw, 22rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(129,140,248,.14); pointer-events: none; user-select: none; z-index: 0; }
  .lg-hero-text { position: relative; z-index: 1; align-self: center; }
  .lg-kicker { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .lg-crumbs { margin-bottom: 1.5rem; }
  .lg-crumbs a { color: var(--color-text-muted); }
  .lg-hero h1 { margin: 0; max-width: none; font-size: clamp(2.3rem, 5.4vw, 4.4rem); font-weight: 400; letter-spacing: -0.03em; line-height: 1.04; }
  .grad { display: block; font-weight: 700; background: linear-gradient(110deg, var(--color-primary-hover), var(--color-accent)); background-clip: text; -webkit-background-clip: text; color: transparent; }
  .lg-lead { color: var(--color-text-muted); font-size: 1.08rem; max-width: 560px; margin: 1.5rem 0 2rem; }
  .lg-actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  /* KPI blocks */

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { glossaryTerms } from '../data/glossary';
import { modules } from '../data/course';
---

<BaseLayout title="Glossario dei dati" description="15 termini di analytics e data engineering con definizioni, esempi pratici e collegamenti ai moduli GinnyTech.">
  <section class="page-hero"><h1>Glossario dei dati</h1><p class="hero-sub">{glossaryTerms.length} termini del percorso, con una definizione e un esempio. Parti da qui quando incontri un concetto nuovo.</p></section>
  <section class="page-content glossary-content">
    <nav class="glossary-index" aria-label="Indice del glossario">{glossaryTerms.map(item => <a href={`#${item.id}`}>{item.term}</a>)}</nav>
    <dl class="glossary-list">
      {glossaryTerms.map(item => (
        <div class="glossary-entry" id={item.id}>
          <dt>{item.term}</dt>
          <dd>
            <p>{item.definition}</p>
            <p><strong>Esempio:</strong> {item.example}</p>
            <p class="glossary-links">Approfondisci: {item.moduleIds.map((id, index) => {
              const module = modules.find(m => m.id === id)!;
              return <><a href={`/programma/${module.slug}/`}>{module.title}</a>{index < item.moduleIds.length - 1 ? ' · ' : ''}</>;
            })}</p>
          </dd>
        </div>
      ))}
    </dl>
    <p class="glossary-more">Per collegare i termini a un ordine di studio, esplora il <a href="/programma/">programma e i percorsi</a>.</p>
  </section>
</BaseLayout>

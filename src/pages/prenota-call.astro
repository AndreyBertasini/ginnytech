---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Prenota una call">
  <section class="page-hero">
    <h1>Prenota una call</h1>
    <p class="hero-sub">Parliamo di dati, carriera o del corso. 15 minuti, senza impegno.</p>
  </section>
  <section class="page-content">
    <p>Vuoi capire se il corso fa per te? Hai un progetto dati e cerchi una consulenza? Prenota una call gratuita di 15 minuti.</p>
    
    <div class="cta-box">
      <a href="https://tidycal.com/andrii-d/15-minute-meeting" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
        Prenota su TidyCal →
      </a>
    </div>
  </section>
</BaseLayout>

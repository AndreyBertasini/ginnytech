---
import BaseLayout from '../layouts/BaseLayout.astro';
import LearningPaths from '../components/LearningPaths.astro';
import { modules } from '../data/course';
---

<BaseLayout description="Un corso gratuito in italiano per collegare metriche, SQL, data engineering e analisi di prodotto e marketing. Esplora i 19 moduli e scegli il tuo percorso.">
  <section class="hero">
    <p class="eyebrow">Corso gratuito in italiano</p>
    <h1>Impara a raccogliere,<br />analizzare e usare i dati.</h1>
    <p class="hero-sub">Collega metriche, SQL e sistemi dati alle domande di prodotto e marketing. Parti dalle conoscenze che hai e scegli cosa approfondire.</p>
    <div class="hero-cta">
      <a href="https://ginnytech.it/course" class="btn btn-primary">Inizia il corso gratuito</a>
      <a href="/programma/" class="btn btn-ghost">Esplora il programma →</a>
    </div>
    <p class="hero-note">{modules.length} moduli · Una base comune · Due percorsi di approfondimento</p>
  </section>

  <section class="inner content-section" aria-labelledby="punto-partenza">
    <h2 id="punto-partenza">Un punto di partenza per il tuo obiettivo</h2>
    <p class="section-sub">Il programma unisce competenze tecniche e ragionamento analitico. Non devi affrontare ogni argomento allo stesso livello.</p>
    <div class="intro-grid">
      <article class="info-card"><span class="eyebrow">01 · Orientati</span><h3>Chiarisci cosa vuoi fare</h3><p>Confronta ruoli e attività nel mondo dei dati e organizza il tuo piano di studio.</p><a href="/programma/modulo-1/" class="text-link">Parti dal metodo di studio →</a></article>
      <article class="info-card"><span class="eyebrow">02 · Consolida</span><h3>Lavora su dati affidabili</h3><p>Studia metriche, matematica e SQL, poi collega raccolta, modellazione e dashboard.</p><a href="/programma/#fondamenti" class="text-link">Vedi i fondamenti →</a></article>
      <article class="info-card"><span class="eyebrow">03 · Approfondisci</span><h3>Scegli una direzione</h3><p>Prosegui con analytics e marketing oppure con la progettazione e gestione dei sistemi dati.</p><a href="#percorsi" class="text-link">Confronta i percorsi →</a></article>
    </div>
  </section>

  <section id="percorsi" class="inner content-section" aria-labelledby="titolo-percorsi">
    <h2 id="titolo-percorsi">Due percorsi, una base comune</h2>
    <p class="section-sub">Per analisti, marketer e chi vuole approfondire il data engineering. Ogni modulo indica le conoscenze richieste: SQL avanzato e i sistemi in tempo reale richiedono già basi tecniche.</p>
    <LearningPaths />
  </section>

  <section id="moduli" class="inner content-section programme-summary" aria-labelledby="titolo-programma">
    <div><p class="eyebrow">Il programma completo</p><h2 id="titolo-programma">Dai primi obiettivi alle decisioni</h2><p class="section-sub">Esplora i {modules.length} moduli con obiettivi, prerequisiti e proposte per esercitarti. Puoi seguire l’ordine consigliato o scegliere gli approfondimenti in base al tuo livello.</p></div>
    <a href="/programma/#moduli" class="btn btn-primary">Vedi tutti i moduli →</a>
  </section>

  <section class="cta-bottom">
    <h2>Hai dubbi su dove iniziare?</h2>
    <p>Parla con Andrii del tuo obiettivo e delle competenze che vuoi sviluppare.</p>
    <a href="/prenota-call/" class="btn btn-primary">Troviamo il tuo punto di partenza</a>
    <a href="/informazioni/" class="btn btn-ghost">Come funziona il corso</a>
  </section>
</BaseLayout>

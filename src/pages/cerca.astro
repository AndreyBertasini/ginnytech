---
import BaseLayout from '../layouts/BaseLayout.astro';
import { modules } from '../data/course';
---

<BaseLayout title="Cerca un modulo" description="Cerca tra titoli, descrizioni e argomenti dei 19 moduli del programma gratuito GinnyTech.">
  <section class="page-hero"><h1>Cerca un modulo</h1><p class="hero-sub">Trova un argomento nel programma. Ogni risultato porta a obiettivi, prerequisiti e proposte per esercitarti.</p></section>
  <section class="page-content search-content" aria-label="Ricerca nel programma">
    <div class="search-box">
      <label for="search-input">Argomento o titolo del modulo</label>
      <input type="search" id="search-input" placeholder="Per esempio: SQL, marketing, Kafka" autocomplete="off" aria-describedby="search-hint" disabled />
      <p id="search-hint" class="search-hint">La ricerca considera titoli, descrizioni e parole chiave dei moduli.</p>
    </div>
    <p id="search-status" class="search-status" role="status" aria-live="polite">{modules.length} moduli nel programma.</p>
    <div id="search-results" class="search-results">
      {modules.map(module => (
        <a href={`/programma/${module.slug}/`} class="search-result" data-search={[module.title, module.summary, ...module.keywords].join(' ')}>
          <span><span class="module-num">MODULO {module.id}</span><strong class="sr-title">{module.title}</strong><span class="sr-description">{module.summary}</span></span>
          <span class="sr-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <p id="search-empty" class="notice" hidden>Nessun modulo trovato. Prova un altro termine o <a href="/programma/">esplora il programma completo</a>.</p>
    <noscript><p class="notice">Puoi consultare tutti i moduli nell’elenco qui sopra. Attiva JavaScript per filtrarli oppure visita il <a href="/programma/">programma completo</a>.</p></noscript>
  </section>
</BaseLayout>

<script>
  import { matchesQuery } from '../lib/search';
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const results = [...document.querySelectorAll<HTMLAnchorElement>('.search-result')];
  const status = document.querySelector<HTMLElement>('#search-status');
  const empty = document.querySelector<HTMLElement>('#search-empty');
  if (input && status && empty) {
    input.disabled = false;
    const update = () => {
      let count = 0;
      for (const result of results) {
        result.hidden = !matchesQuery(result.dataset.search || '', input.value);
        if (!result.hidden) count++;
      }
      status.textContent = count === 1 ? '1 modulo trovato.' : `${count} moduli trovati.`;
      empty.hidden = count > 0;
    };
    input.addEventListener('input', update);
    update();
  }
</script>

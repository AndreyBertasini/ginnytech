---
import BaseLayout from '../layouts/BaseLayout.astro';
const previews = [
  { title: 'Come trovare gli ostacoli in un funnel', description: 'Distingui problemi di acquisizione, attivazione e conversione analizzando i passaggi del percorso utente.', category: 'Analisi di prodotto', moduleId: 5 },
  { title: 'Da GA4 al data warehouse', description: 'Le domande da affrontare prima di importare eventi: granularità, storico e regole di qualità.', category: 'Data engineering', moduleId: 9 },
  { title: 'Collegare i KPI alle decisioni', description: 'Come scegliere indicatori associati a obiettivi, azioni e responsabilità.', category: 'Metriche', moduleId: 3 },
  { title: 'Misurare l’effetto incrementale del marketing', description: 'Perché attribuire una conversione non basta a dimostrare che una campagna l’abbia causata.', category: 'Analisi di marketing', moduleId: 6 },
];
---

<BaseLayout title="Articoli e approfondimenti" description="Scopri i temi degli approfondimenti GinnyTech in preparazione e i moduli collegati su metriche, analytics e data engineering.">
  <section class="page-hero"><h1>Articoli e approfondimenti</h1><p class="hero-sub">Idee e domande per collegare dati, strumenti e problemi di lavoro.</p></section>
  <section class="page-content articles-content">
    <p class="notice">Gli articoli sono in preparazione.</p>
    <p>I temi qui sotto sono anteprime, non articoli già pubblicati. Puoi intanto approfondire gli argomenti nei moduli collegati del corso gratuito.</p>
    <div class="article-list">
      {previews.map(article => (
        <article class="article-card">
          <span class="eyebrow">{article.category} · Anteprima</span>
          <h2>{article.title}</h2>
          <p>{article.description}</p>
          <a href={`/programma/modulo-${article.moduleId}/`} class="text-link">Esplora il modulo collegato →</a>
        </article>
      ))}
    </div>
    <div class="cta-box"><p>Vuoi orientarti tra gli argomenti?</p><a href="/programma/" class="btn btn-primary">Consulta il programma</a></div>
  </section>
</BaseLayout>
